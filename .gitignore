# .gitignore - Prevent committing sensitive files
.env
node_modules/
.DS_Store
*.log
dist/
out/
tools/private.pem
tools/last-license.txt

# Code signing certificate — never commit this
build/*.pfx
build/*.p12
build/*.cert

# Local test data and session notes — not for public distribution
test_data/
test_encrypted_data/
SESSION_MEMORY.md
SESSION_SUMMARY.md
code.js
dy

# Illustrator export folders
256w/
300w/
512w/
720w/