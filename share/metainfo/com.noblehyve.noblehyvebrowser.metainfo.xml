  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Noblehyve</name>
  <summary>Secure browser with encrypted code editor and cloud storage</summary>
  <description>
    <p>
      Noblehyve is a secure web browser built on Electron, featuring:
    </p>
    <ul>
      <li>Encrypted code editor with syntax highlighting and cloud sync</li>
      <li>End-to-end encrypted cloud storage via Cloudflare R2</li>
      <li>Built-in terminal with PTY support</li>
      <li>Phishing and malware domain protection</li>
      <li>Session management with tab persistence</li>
      <li>File encryption for local and cloud storage</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.noblehyve.noblehyvebrowser.desktop</launchable>
